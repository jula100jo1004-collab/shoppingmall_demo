PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/shopping-mall?retryWrites=true&w=majority
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Vercel 프론트 주소 (여러 개면 콤마로 구분, 끝에 / 없이)
# 예: https://shopping-mall-demo.vercel.app
CLIENT_ORIGIN=https://your-app.vercel.app
